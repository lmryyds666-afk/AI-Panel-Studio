datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Discussion {
  id          String   @id @default(uuid())
  topic       String
  status      String   @default("SETUP")
  expertCount Int      @default(4)
  summary     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guests            Guest[]
  speeches          Speech[]
  consensusRecords  ConsensusRecord[]

  @@map("discussions")
}

model Guest {
  id           String @id @default(uuid())
  discussionId String
  name         String
  role         String @default("EXPERT")
  occupation   String
  title        String
  stance       String
  color        String
  runStatus    String @default("IDLE")
  sortOrder    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  speeches   Speech[]

  @@index([discussionId])
  @@map("guests")
}

model Speech {
  id           String  @id @default(uuid())
  discussionId String
  guestId      String
  content      String
  speechType   String
  sequence     Int
  isVisible    Boolean @default(true)

  createdAt DateTime @default(now())

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  guest      Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@index([guestId])
  @@index([discussionId, sequence])
  @@map("speeches")
}

model ConsensusRecord {
  id               String @id @default(uuid())
  discussionId     String
  recordType       String
  content          String
  relatedSpeechIds String @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@index([discussionId, recordType])
  @@map("consensus_records")
}
